rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function horario(tok) {
      return get(/databases/$(database)/documents/horarios/$(tok)).data;
    }
    function hayHorario(tok) {
      return tok is string && exists(/databases/$(database)/documents/horarios/$(tok));
    }
    function esDueno(owner) {
      return request.auth != null && request.auth.uid == owner;
    }

    // Datos de la profesora (alumnos, meses, ajustes y sus dispositivos para avisos).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Horario público de cada alumno: se lee solo con el código del enlace.
    match /horarios/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if esDueno(request.resource.data.owner);
      allow update: if esDueno(resource.data.owner) && esDueno(request.resource.data.owner);
      allow delete: if esDueno(resource.data.owner);
    }

    // Peticiones: clase extra, cambio de clase o aviso de falta.
    match /solicitudes/{id} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;

      // El alumno (con un enlace válido) crea una petición para sí mismo.
      allow create: if request.resource.data.keys().hasOnly(
                         ['owner','token','alumnoId','nombre','tipo','f','t','h','de','nota','motivo','estado','por','creada','actualizada','aplicada'])
                    && hayHorario(request.resource.data.token)
                    && horario(request.resource.data.token).owner == request.resource.data.owner
                    && horario(request.resource.data.token).alumnoId == request.resource.data.alumnoId
                    && horario(request.resource.data.token).nombre == request.resource.data.nombre
                    && request.resource.data.tipo in ['extra','cambio','falta']
                    && request.resource.data.estado == (request.resource.data.tipo == 'falta' ? 'aviso' : 'pendiente')
                    && request.resource.data.aplicada == false
                    && request.resource.data.f is string && request.resource.data.f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.t is string && request.resource.data.t.size() <= 5
                    && request.resource.data.h in [1, 1.5, 2, 2.5, 3]
                    && request.resource.data.nota is string && request.resource.data.nota.size() <= 300
                    && (!('motivo' in request.resource.data) || (request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300))
                    && (!('de' in request.resource.data) || request.resource.data.de is map);

      // El alumno responde a una propuesta o cancela una petición suya pendiente.
      allow update: if request.auth == null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','f','t','h','nota','por','actualizada'])
                    && request.resource.data.por == 'alumno'
                    && (
                         (resource.data.estado == 'propuesta' && request.resource.data.estado in ['confirmada','pendiente','cancelada'])
                      || (resource.data.estado == 'pendiente' && request.resource.data.estado in ['cancelada','pendiente'])
                       )
                    && request.resource.data.f is string && request.resource.data.f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.t is string && request.resource.data.t.size() <= 5
                    && request.resource.data.h in [1, 1.5, 2, 2.5, 3]
                    && request.resource.data.nota is string && request.resource.data.nota.size() <= 300;

      // La profesora acepta, rechaza, propone otra hora o borra.
      allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // Avisos push: los escribe la app y los envía la función "enviarAviso".
    match /avisos/{id} {
      allow create: if (
            request.resource.data.para == 'profesora'
         && request.resource.data.keys().hasOnly(['para','owner','token','titulo','cuerpo','creado'])
         && hayHorario(request.resource.data.token)
         && horario(request.resource.data.token).owner == request.resource.data.owner
         && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 100
         && request.resource.data.cuerpo is string && request.resource.data.cuerpo.size() <= 300
        ) || (
            request.resource.data.para == 'alumnos'
         && request.resource.data.keys().hasOnly(['para','owner','alumnos','titulo','cuerpo','creado'])
         && esDueno(request.resource.data.owner)
         && request.resource.data.alumnos is list && request.resource.data.alumnos.size() <= 60
        );
      allow read, update, delete: if false;
    }

    // Dispositivos de cada alumno para recibir avisos (por código de enlace).
    match /pushAlumnos/{token} {
      allow create, update: if hayHorario(token)
                    && request.resource.data.keys().hasOnly(['tokens','actualizado'])
                    && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10;
      allow read, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
